# =====================================================================
# ExamReady.ng — Environment Variables
# Copy this file to `.env.local` (per app) and fill in real values.
# Never commit real secrets. Production values live in Vercel env config.
# =====================================================================

# -------- Runtime --------
NODE_ENV=development
LOCAL_DEV=true
DEV_AUTH_BYPASS=false
# When DEV_AUTH_BYPASS=true, /api/* accepts an `x-dev-user-id` header instead
# of a real Supabase session. Local dev only — must never be true in prod.

# -------- Database (Postgres) --------
# Local: docker-compose Postgres
# Prod:  Supabase pooler (port 6543) for app connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examready
# DIRECT_URL is the unpooled connection used only for migrations (drizzle-kit).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/examready

# -------- Supabase --------
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public-safe variants exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Send SMS Hook secret — Auth → Hooks → Send SMS Hook
SUPABASE_AUTH_HOOK_SECRET=

# -------- Upstash Redis --------
# https://console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------- Upstash QStash --------
# https://console.upstash.com → QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -------- Termii (WhatsApp + SMS) --------
# https://accounts.termii.com → API Keys
TERMII_API_KEY=
TERMII_SENDER_ID=ExamReady
# Device ID for WhatsApp templates (registered separately in Termii dashboard)
TERMII_WHATSAPP_DEVICE_ID=

# -------- Resend (Email) --------
# https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@examready.ng

# -------- Paystack (Payments) --------
# https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# -------- AI providers --------
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# -------- Analytics & monitoring --------
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -------- Search (Meilisearch) --------
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=examready-dev-master-key

# -------- Google OAuth --------
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------- Google AdSense --------
# Set after AdSense application is approved. Until then, ads will not render.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# -------- Cloudflare R2 (video & PDF storage) --------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=examready-media

# -------- Vercel Blob (small assets) --------
BLOB_READ_WRITE_TOKEN=

# -------- Cron --------
# Used by Vercel Cron to authenticate scheduled invocations of /api/cron/*
# Generate with: openssl rand -hex 32
CRON_SECRET=
