# =====================================================================
# ExamReady.ng — Environment Variables
# Copy this file to `.env.local` (per app) and fill in real values.
# Never commit real secrets. Production values live in Vercel env config.
# =====================================================================

# -------- Runtime --------
NODE_ENV=development
LOCAL_DEV=true
DEV_AUTH_BYPASS=false
# When DEV_AUTH_BYPASS=true, /api/* accepts an `x-dev-user-id` header instead
# of a real Supabase session. Local dev only — must never be true in prod.

# -------- Database (Postgres) --------
# Local: docker-compose Postgres
# Prod:  Supabase pooler (port 6543) for app connections
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/examready
# DIRECT_URL is the unpooled connection used only for migrations (drizzle-kit).
DIRECT_URL=postgresql://postgres:postgres@localhost:5432/examready

# -------- Supabase --------
# https://supabase.com/dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Public-safe variants exposed to the browser
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Send SMS Hook secret — Auth → Hooks → Send SMS Hook
SUPABASE_AUTH_HOOK_SECRET=

# -------- Upstash Redis --------
# https://console.upstash.com → Database → REST API
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# -------- Upstash QStash --------
# https://console.upstash.com → QStash
QSTASH_TOKEN=
QSTASH_CURRENT_SIGNING_KEY=
QSTASH_NEXT_SIGNING_KEY=

# -------- Termii (WhatsApp + SMS) --------
# https://accounts.termii.com → API Keys
TERMII_API_KEY=
TERMII_SENDER_ID=ExamReady
# Device ID for WhatsApp templates (registered separately in Termii dashboard)
TERMII_WHATSAPP_DEVICE_ID=

# -------- Resend (Email) --------
# https://resend.com → API Keys
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@examready.ng

# -------- Paystack (Payments) --------
# https://dashboard.paystack.com → Settings → API Keys & Webhooks
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=

# -------- AI providers (Sprint 6: DeepSeek-only + OpenAI fallback) --------
# Sprint 6 migrated all features to DeepSeek with OpenAI gpt-4o-mini as
# emergency fallback. See lib/ai/README.md for routing per feature.

# DeepSeek — primary for every feature. https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# OpenAI — emergency fallback only (gpt-4o-mini). Triggers on DeepSeek 5xx/timeout.
# https://platform.openai.com/api-keys
OPENAI_API_KEY=

# Pidgin feature flag (Sprint 6). Default: disabled.
# Pidgin is gated until a Nigerian-fluent human verifies sample quality
# (see PIDGIN_SAMPLES.md). Set to 'true' to surface the option in the UI
# and accept Pidgin requests at the API. The code, prompts and routing
# all stay intact — only this flag controls availability.
PIDGIN_ENABLED=false
# Public mirror of PIDGIN_ENABLED — controls whether the "In Pidgin" option
# is surfaced in the ExplanationCard dropdown. Must match PIDGIN_ENABLED;
# they are separate vars only because Next.js requires NEXT_PUBLIC_ prefix
# for client-bundled values.
NEXT_PUBLIC_PIDGIN_ENABLED=false

# Local-inference opt-in (Sprint 6). Advanced setup, NOT recommended for
# production at launch — DeepSeek is fast and cheap enough that local
# self-hosting only pays off at high scale or for personal dev use.
# When enabled, non-critical features (explain-differently, questionGen)
# try the local server FIRST. Critical features (tutor, aiExaminer,
# studyPlan) always go to DeepSeek regardless of this flag.
# Suggested models: Qwen2.5-32B-Coder-Instruct (questionGen, fits 24GB),
# Llama-3.3-70B-Instruct Q4 (explain-differently, recommend 32GB+).
LOCAL_AI_ENABLED=false
LOCAL_AI_BASE_URL=

# Anthropic (Claude) — DISABLED at Sprint 6, kept as commented dead code
# in lib/ai/providers/anthropic.ts for future re-introduction. Setting
# this var has no effect at runtime (the provider is not registered in
# the factory). Leave blank unless re-enabling Anthropic in a future sprint.
# ANTHROPIC_API_KEY=

# -------- Analytics & monitoring --------
POSTHOG_API_KEY=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=

# -------- Search (Meilisearch) --------
MEILI_HOST=http://localhost:7700
MEILI_API_KEY=examready-dev-master-key

# -------- Google OAuth --------
# https://console.cloud.google.com → APIs & Services → Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# -------- Google AdSense --------
# Set after AdSense application is approved. Until then, ads will not render.
NEXT_PUBLIC_ADSENSE_CLIENT_ID=

# Per-placement slot IDs from your AdSense dashboard. Leave blank until you
# create the ad units. AdSlot returns null for any placement whose slot is
# unset, so partial configuration is safe.
NEXT_PUBLIC_ADSENSE_SLOT_DASHBOARD_SIDEBAR=
NEXT_PUBLIC_ADSENSE_SLOT_PRACTICE_INTERSTITIAL=
NEXT_PUBLIC_ADSENSE_SLOT_RESULTS_TOP=
NEXT_PUBLIC_ADSENSE_SLOT_FOOTER_BANNER=

# -------- Cloudflare R2 (video & PDF storage) --------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=examready-media

# -------- Vercel Blob (small assets) --------
BLOB_READ_WRITE_TOKEN=

# -------- Cron --------
# Used by Vercel Cron to authenticate scheduled invocations of /api/cron/*
# Generate with: openssl rand -hex 32
CRON_SECRET=

# -------- Admin app config --------
# The admin app calls the web app's API. Set this to the web app's public
# URL so admin (running on a different subdomain in production, port 3001
# in dev) can reach it. Empty/unset → admin uses same-origin fetches.
NEXT_PUBLIC_API_BASE_URL=
# Local dev only — when true, admin app accepts any signed-in user as admin
# (no role check). Never enable in production.
DEV_AUTH_BYPASS=false
