    "seed": "tsx seed/seed.ts",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.2",
    "postgres": "^3.4.4"
  },
  "devDependencies": {
    "@examready/eslint-config": "workspace:*",
    "@examready/tsconfig": "workspace:*",
    "@types/node": "^20.16.5",
    "dotenv": "^16.4.5",
    "drizzle-kit": "^0.31.0",
    "tsx": "^4.19.1",
    "typescript": "^5.5.4",
    "vitest": "^2.1.1"
  }
}
