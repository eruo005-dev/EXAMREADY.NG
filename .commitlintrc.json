{
  "extends": ["@commitlint/config-conventional"],
  "rules": {
    "type-enum": [
      2,
      "always",
      ["feat", "fix", "chore", "docs", "refactor", "test", "perf", "ci", "build", "style", "revert"]
    ],
    "subject-case": [0],
    "body-max-line-length": [0],
    "footer-max-line-length": [0]
  }
}
